# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
.pip_cache/

# --- Testing & Tooling ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- HuggingFace & Deep Learning Model Weights ---
.hf_cache/
hf_cache/
*.bin
*.pt
*.pth
*.safetensors
*.onnx

# --- Pipeline Run Outputs & Caches ---
outputs/
cache/
runs.jsonl
failures.jsonl
*.parquet

# --- Large Media & External Datasets ---
# Keep synthetic toy dataset for selfcheck & smoke tests, ignore external datasets
data/*
!data/toy/
*.mp4
*.avi
*.mkv
*.mov
*.webm

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- IDEs & Editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
ea/config.local.yaml
