# =============================================================================
# Qwen3-VL Error Analysis Environment Variables
# Copy to `.env` to override defaults for docker-compose
# =============================================================================

# HuggingFace cache directory on the host (where weights will be saved/loaded)
# Default on server: ./.hf_cache
# Example on Windows: F:/URCA_PROJECTS/.hf_cache
HF_CACHE_DIR=./.hf_cache

# Benchmark datasets directory on the host
DATA_DIR=./data

# Optional default benchmark override (e.g. cs10k, pasbench, toy)
# BENCH=cs10k

# Run outputs directory on the host
OUTPUTS_DIR=./outputs

# HuggingFace token (optional, useful for higher rate limits or gated models)
HF_TOKEN=

# Model identifier override (repo ID or explicit snapshot directory)
# MODEL_NAME=Qwen/Qwen3-VL-4B-Instruct
# MODEL_PATH=/workspace/.hf_cache/hub/models--Qwen--Qwen3-VL-4B-Instruct/snapshots/...
